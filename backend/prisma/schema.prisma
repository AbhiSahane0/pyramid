generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Permissions inside a workspace. OWNER is the creator: exactly one per
/// workspace, cannot be demoted or removed (that would orphan the workspace).
enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum Priority {
  NO_PRIORITY
  URGENT
  HIGH
  MEDIUM
  LOW
}

model User {
  id                 String  @id @default(cuid())
  email              String  @unique
  name               String
  username           String?
  title              String?
  avatarUrl          String?
  googleId           String? @unique
  isGuest            Boolean @default(false)
  /// True for seeded "workspace member" personas (Admin, Designer, QA Team…)
  /// that exist only to be assigned to tasks — they can never log in.
  isDemo             Boolean @default(false)
  hashedRefreshToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  invitationsSent Invitation[] @relation("InvitationsSent")

  createdProjects Project[]  @relation("ProjectCreator")
  createdTasks    Task[]     @relation("TaskCreator")
  ledProjects     Project[]  @relation("ProjectLead")
  reportedTasks   Task[]     @relation("TaskReporter")
  memberTasks     Task[]     @relation("TaskMembers")
  comments        Comment[]
  activities      Activity[]
}

/// A team. Projects and tasks belong to a workspace, not to a person, so every
/// member sees the same board and nothing is lost when someone leaves.
model Workspace {
  id   String @id @default(cuid())
  name String

  members     Membership[]
  invitations Invitation[]
  projects    Project[]
  tasks       Task[]
  columns     BoardColumn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Join table between User and Workspace, carrying the role.
model Membership {
  id   String        @id @default(cuid())
  role WorkspaceRole @default(MEMBER)

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// One membership per user per workspace — re-inviting an existing member
  /// is rejected by the database, not just by application code.
  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

/// A pending magic-link invitation. Only the SHA-256 of the token is stored,
/// so a database leak cannot be replayed into workspace access.
model Invitation {
  id         String        @id @default(cuid())
  email      String
  role       WorkspaceRole @default(MEMBER)
  tokenHash  String        @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedById String?
  invitedBy   User?     @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([email])
}

model Project {
  id       String    @id @default(cuid())
  name     String
  priority Priority  @default(NO_PRIORITY)
  dueDate  DateTime?

  /// The workspace owns the project; membership is what grants access.
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Attribution only — nullable so removing a user keeps their work.
  createdById String?
  createdBy   User?   @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  leadId      String?
  lead        User?   @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  priority    Priority  @default(NO_PRIORITY)
  startDate   DateTime?
  dueDate     DateTime?
  /// Fractional ordering key within a status column (Kanban drag & drop).
  position    Float     @default(0)

  /// The workspace owns the task; membership is what grants access.
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Which board column the task sits in. Restricted, not cascading: a column
  /// holding work must be emptied deliberately, never silently taken with it.
  columnId String
  column   BoardColumn @relation(fields: [columnId], references: [id], onDelete: Restrict)

  /// Attribution only — nullable so removing a user keeps their work.
  createdById String?
  createdBy   User?    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporterId  String?
  reporter    User?    @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  /// Subtasks are tasks with a parent.
  parentId String?
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("Subtasks")

  members    User[]     @relation("TaskMembers")
  labels     Label[]    @relation("TaskLabels")
  comments   Comment[]
  activities Activity[]
  resources  Resource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Matches the board's main query: scope by workspace, group by column,
  /// order by position.
  @@index([workspaceId, columnId, position])
  @@index([parentId])
}

/// A column on the board. Workspaces define their own — the five the app ships
/// with are rows like any other, so "Blocked" is not a schema change.
model BoardColumn {
  id       String @id @default(cuid())
  name     String
  /// Palette key (see BOARD_COLORS), not a raw CSS value: the board has to
  /// stay legible in both themes, which a user-supplied hex cannot promise.
  color    String @default("slate")
  /// Left-to-right order, shared by everyone looking at the board.
  position Float  @default(0)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Two columns with one name make the board unreadable and "move to Done"
  /// ambiguous.
  @@unique([workspaceId, name])
  @@index([workspaceId, position])
}

model Label {
  id    String @id @default(cuid())
  name  String @unique
  tasks Task[] @relation("TaskLabels")
}

model Resource {
  id     String @id @default(cuid())
  name   String
  url    String
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Comment {
  id   String @id @default(cuid())
  body String

  taskId   String
  task     Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId String?
  parent   Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("Replies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

model Activity {
  id   String @id @default(cuid())
  /// e.g. "priority_changed", "status_changed", "update_posted"
  type String
  meta Json?

  taskId  String
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([taskId])
}
