# --- Server ---
# Port the NestJS API listens on
PORT=4000
# Node environment: development | production
NODE_ENV=development
# Origin of the Next.js frontend (CORS + OAuth redirect target)
FRONTEND_URL=http://localhost:3000

# --- Database ---
# Postgres connection string (docker-compose default below)
DATABASE_URL=postgresql://pyramid:pyramid@localhost:5432/pyramid

# --- JWT ---
# Secrets for signing tokens. Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Token lifetimes (vercel/ms format)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Google OAuth 2.0 ---
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
# The "Authorised redirect URI" in Google must match GOOGLE_CALLBACK_URL exactly.
#
# IMPORTANT: the callback must sit on the FRONTEND origin, not the API origin.
# The browser only ever talks to the frontend, which proxies /api/* to this
# server (see frontend/next.config.ts). Routing the callback through that proxy
# is what makes the session cookie first-party on the frontend domain. Point it
# straight at the API host instead and the cookie is set on the API's domain,
# which the browser will never send back to the frontend -> every request 401s
# and the user bounces back to /login.
#
#   Local:      http://localhost:3000/api/auth/google/callback
#   Production: https://<your-frontend-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- Cookies ---
# Leave empty. Because every browser request is same-origin against the
# frontend, the cookie needs no explicit domain and SameSite=Lax is enough.
# Only set this if you deliberately serve the API from a sibling subdomain.
COOKIE_DOMAIN=

# --- Email (workspace invitations) ---
# Optional. Without a key the invite link is logged instead of emailed, so the
# flow still works end to end — the inviter copies the link from the UI.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender. resend.dev works for testing without owning a domain.
MAIL_FROM=Pyramid <onboarding@resend.dev>
