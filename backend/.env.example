# --- Server ---
# Port the NestJS API listens on
PORT=4000
# Node environment: development | production
NODE_ENV=development
# Origin of the Next.js frontend (CORS + OAuth redirect target)
FRONTEND_URL=http://localhost:3000

# --- Database ---
# Postgres connection string (docker-compose default below)
DATABASE_URL=postgresql://pyramid:pyramid@localhost:5432/pyramid

# --- JWT ---
# Secrets for signing tokens. Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Token lifetimes (vercel/ms format)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Google OAuth 2.0 ---
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
# Authorized redirect URI must exactly match GOOGLE_CALLBACK_URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# --- Cookies ---
# Leave empty for localhost. In production set to the apex domain if API and
# frontend share one (otherwise cookies use SameSite=None; Secure).
COOKIE_DOMAIN=
